# Telegram Bot Configuration
API_ID=12345
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=m3u8_recorder

# Bot Settings
OWNER_ID=123456789
NUM_WORKERS=3
DOWNLOAD_DIR=downloads
MAX_FILE_SIZE_GB=1.95

# User Tier Defaults (in minutes)
DEFAULT_MAX_DURATION=30
VERIFIED_MAX_DURATION=120
PREMIUM_MAX_DURATION=720

# Shortlink Verification
SHORTLINK_API_URL=
SHORTLINK_API_KEY=

# Verification interval (hours) – how long a /verify token is valid
DEFAULT_VERIFY_HOURS=24

# N3U8DL-RE binary path (for DRM/MPD stream support)
N3U8DL_PATH=N_m3u8DL-RE
